# Cấu hình backend; copy sang .env nếu chưa có, không ghi đè file đã chỉnh.
# FE dùng frontend/.env.local với NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000.
# CORS phải khớp origin trang FE; đổi cổng FE thì cập nhật RESIM_CORS_ORIGINS.

RESIM_STORAGE_DIR=.storage
RESIM_MAX_UPLOAD_BYTES=10485760
RESIM_MAX_IMAGE_PIXELS=20000000
RESIM_IMAGE_TTL_HOURS=24
RESIM_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
